{
  "name": "qa-mobile-carrefour-wdio",
  "version": "1.0.0",
  "description": "Desafio Técnico de Automação de Testes Mobile para o Banco Carrefour utilizando JavaScript, WebDriverIO, Appium e Page Object Model com native-demo-app.",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "test:android": "wdio run config/wdio.android.conf.js",
    "test:ios": "wdio run config/wdio.ios.conf.js",
    "test:browserstack": "wdio run config/wdio.browserstack.conf.js",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report"
  },
  "keywords": [
    "webdriverio",
    "appium",
    "mobile",
    "carrefour",
    "qa",
    "javascript",
    "native-demo-app",
    "page-object-model",
    "data-driven",
    "browserstack"
  ],
  "author": "Candidato QA - Banco Carrefour Challenge",
  "license": "MIT",
  "devDependencies": {
    "@wdio/allure-reporter": "^8.28.0",
    "@wdio/appium-service": "^8.28.0",
    "@wdio/cli": "^8.28.0",
    "@wdio/local-runner": "^8.28.0",
    "@wdio/mocha-framework": "^8.28.0",
    "@wdio/spec-reporter": "^8.28.0",
    "allure-commandline": "^2.27.0",
    "appium": "^2.19.0",
    "appium-uiautomator2-driver": "^3.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}

